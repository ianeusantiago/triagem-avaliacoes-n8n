      "retryOnFail": true,
      "waitBetweenTries": 700
    },
    {
      "parameters": {
        "jsCode": "function acharJson(valor) {\n  if (valor && typeof valor === 'object') {\n    if (valor.categoria || valor.resumo) return valor;\n    for (const v of Object.values(valor)) {\n      const achado = acharJson(v);\n      if (achado) return achado;\n    }\n  }\n  if (typeof valor === 'string' && valor.includes('{')) {\n    try { return JSON.parse(valor.slice(valor.indexOf('{'), valor.lastIndexOf('}') + 1)); } catch {}\n  }\n  return null;\n}\nconst dados = acharJson($json);\nif (!dados) throw new Error('Não achei o JSON na resposta do modelo');\nreturn { json: dados };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        0
      ],
      "id": "9d4d2414-800c-44ef-9c56-72d73dc98e2d",
      "name": "Ler classificação"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Você ajuda o dono de um restaurante a responder avaliações de clientes de um app de delivery.\n\nAvaliação do cliente: {{ $('Webhook').item.json.body.texto }}\nNota: {{ $('Webhook').item.json.body.nota }} de 5\nClassificação: categoria {{ $json.categoria }}, urgência {{ $json.urgencia }}\n\nResponda APENAS com um JSON válido neste formato:\n{\n  \"resumo\": \"o problema em até 12 palavras, para o dono ler rápido\",\n  \"resposta_sugerida\": \"resposta educada ao cliente, em até 3 frases, em português do Brasil\"\n}\n\nRegras da resposta sugerida:\n- Agradeça e, se houver problema, peça desculpas sem dar desculpas.\n- Não prometa reembolso, cupom ou desconto: isso é decisão do dono.\n- Se a urgência for alta, diga que o restaurante vai entrar em contato.\n- Não use o nome do cliente.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
